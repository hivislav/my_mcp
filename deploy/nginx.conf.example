# Reverse-proxy template for putting the MCP server behind TLS.
#
# Why a proxy at all: the MCP server speaks plain HTTP. Sending a bearer token
# over plain HTTP to a public VPS would expose it on every request.
#
# The server runs in stateless mode, so no session affinity is required and you
# can run several replicas behind the same upstream block.

upstream open_meteo_mcp {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mcp.example.com;

    ssl_certificate     /etc/letsencrypt/live/mcp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.example.com/privkey.pem;

    # Requests are small JSON-RPC calls; a tight limit reduces abuse surface.
    client_max_body_size 1m;

    location /mcp {
        proxy_pass http://open_meteo_mcp;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Required for the Authorization header carrying the bearer token.
        proxy_set_header Authorization     $http_authorization;

        # Streamable HTTP can upgrade to SSE, which must not be buffered.
        proxy_set_header Connection        "";
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;

        # A weather tool call needs outbound time plus retries; keep this above
        # OPEN_METEO_TIMEOUT_MS * (OPEN_METEO_MAX_RETRIES + 1).
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Keep /healthz reachable for monitoring but off the public internet.
    location /healthz {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://open_meteo_mcp;
        proxy_set_header Host $host;
    }

    location / {
        return 404;
    }
}

# Redirect plain HTTP to HTTPS so a token can never be sent in the clear.
server {
    listen 80;
    listen [::]:80;
    server_name mcp.example.com;
    return 301 https://$host$request_uri;
}
