# Copy to .env and fill in. Never commit the real .env.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# stdio  — the MCP client spawns the process (local use).
# http   — the server listens on a socket (VPS use).
MCP_TRANSPORT=http

# Bind address. Use 127.0.0.1 when a reverse proxy on the same host terminates
# TLS, and 0.0.0.0 only inside a container or a private network.
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_PATH=/mcp

# ---------------------------------------------------------------------------
# Authentication — REQUIRED for any non-loopback bind
# ---------------------------------------------------------------------------
# Shared secret the agent must send as: Authorization: Bearer <token>
# Generate one with:  openssl rand -hex 32
MCP_AUTH_TOKEN=

# Only set this if another layer already protects the endpoint (VPN, private
# network, mTLS proxy). The server refuses a public bind without a token
# unless this is explicitly true.
# MCP_ALLOW_UNAUTHENTICATED=false

# ---------------------------------------------------------------------------
# Session handling
# ---------------------------------------------------------------------------
# stateless — a fresh instance per request; no session affinity, safe to restart
#             or scale horizontally. This server never pushes unsolicited
#             messages, so stateless is sufficient. (default)
# stateful  — sessions tracked via Mcp-Session-Id; resumable streams, but pins a
#             client to one process and consumes memory per session.
MCP_SESSION_MODE=stateless

# true  — reply with a single JSON body (simplest for HTTP agents and proxies).
# false — reply with an SSE stream; required only for server-initiated messages.
MCP_JSON_RESPONSE=true

# ---------------------------------------------------------------------------
# CORS — leave unset unless a browser calls the endpoint directly
# ---------------------------------------------------------------------------
# Comma-separated origins, or * to allow any.
# MCP_ALLOWED_ORIGINS=https://app.example.com
MCP_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Periodic weather collector (the weather-watch tools)
# ---------------------------------------------------------------------------
# The collector runs inside the server process on a timer, polls every watched
# location, and appends each reading to JSON under WATCH_DATA_DIR. It starts with
# the process, independently of whether anyone calls a tool.
WATCH_ENABLED=true

# Seconds between collection cycles (30..86400). 900 = every 15 minutes.
WATCH_INTERVAL_SECONDS=900

# Samples older than this are pruned on every write (1..8760 hours).
# 168 = 7 days.
WATCH_RETENTION_HOURS=168

# Where watches.json and samples/<id>.json are written.
#
# IMPORTANT: the container runs with a read-only root filesystem, so this path
# must be a mounted volume that uid 1000 can write. docker-compose.yml already
# mounts ./data at /app/data. If this path is not writable the collector disables
# itself, /healthz reports watcher.available=false, and the watch tools return an
# explanatory error instead of silently collecting nothing.
WATCH_DATA_DIR=./data

# Maximum number of concurrent watches.
WATCH_MAX_WATCHES=20

# ---------------------------------------------------------------------------
# Saved summaries and Excel export (save_weather_summary / export_..._excel)
# ---------------------------------------------------------------------------
# A summary is a table of weather values the agent chose to keep, plus its own
# written analysis. It is independent of the watch history: it never expires, and
# it is what gets turned into a spreadsheet.
#
# Where one JSON file per dataset is written, with generated .xlsx files under
# exports/. The default keeps everything inside WATCH_DATA_DIR, so the single
# ./data volume mounted by docker-compose.yml already covers it. Point this
# somewhere else only if you want the two features on separate volumes.
# SUMMARY_DATA_DIR=./data/summaries

# Guards against a runaway agent filling the volume. Removing a dataset means
# deleting its JSON file under SUMMARY_DATA_DIR on the host, or overwriting it
# with replace: true.
SUMMARY_MAX_DATASETS=200
SUMMARY_MAX_ENTRIES=5000

# Largest .xlsx returned inline as base64 in the tool result. Larger files are
# still written to disk and reported by path, just not embedded in the reply.
# Set to 0 to never embed the file.
SUMMARY_MAX_INLINE_BYTES=8388608

# How many generated .xlsx files to keep per dataset; older ones are pruned.
SUMMARY_MAX_EXPORTS=10

# ---------------------------------------------------------------------------
# Open-Meteo upstream
# ---------------------------------------------------------------------------
# NOTE ON THE DEFAULT: the classic host `api.open-meteo.com` is unreachable from
# some networks — its IP blackholes while every other Open-Meteo host still
# answers. The default below is therefore the ensemble host, which serves the
# IDENTICAL JSON schema (same variable names, same WMO codes, same units) and is
# reachable everywhere. It needs an explicit `models=` because it rejects the
# default `best_match`.
#
# Two supported configurations:
#
#   A) Default — reachable from anywhere, 16-day horizon.
#        OPEN_METEO_FORECAST_URL=https://ensemble-api.open-meteo.com
#        OPEN_METEO_FORECAST_PATH=/v1/ensemble
#        OPEN_METEO_MODELS=gfs05
#      Trade-off: `precipitation_probability` is always null (the ensemble
#      product does not expose it). `gfs05` is the model with the full 16-day
#      range; `icon_seamless` covers only 7 days, `ecmwf_ifs025` 14.
#
#   B) Standard host — use this on a VPS that can reach it. Restores
#      precipitation probability and lets Open-Meteo choose its own best_match.
#        OPEN_METEO_FORECAST_URL=https://api.open-meteo.com
#        OPEN_METEO_FORECAST_PATH=/v1/forecast
#        OPEN_METEO_MODELS=            # blank = send no models parameter
#
# Leave everything commented to get configuration A.
# OPEN_METEO_FORECAST_URL=https://ensemble-api.open-meteo.com
# OPEN_METEO_FORECAST_PATH=/v1/ensemble
# OPEN_METEO_MODELS=gfs05

# Geocoding and air quality use their own hosts and are reachable either way.
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com

# Only needed for a commercial Open-Meteo plan.
# OPEN_METEO_API_KEY=

OPEN_METEO_TIMEOUT_MS=15000
OPEN_METEO_MAX_RETRIES=2
# Open-Meteo asks API consumers to identify themselves.
OPEN_METEO_USER_AGENT=open-meteo-mcp/1.0.0 (+https://github.com/your-org/open-meteo-mcp)

# ---------------------------------------------------------------------------
# Logging — always JSON on stderr, never stdout (stdout is the MCP channel)
# ---------------------------------------------------------------------------
LOG_LEVEL=info
